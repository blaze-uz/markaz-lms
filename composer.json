{
    "name": "markaz-lms/markaz-lms",
    "type": "project",
    "description": "A learning management system for training centres.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "asantibanez/livewire-charts": "^3.0",
        "aws/aws-sdk-php": "^3.356",
        "defstudio/telegraph": "^1.48",
        "diglactic/laravel-breadcrumbs": "^8.1",
        "doctrine/dbal": "^3.9",
        "guzzlehttp/guzzle": "^7.9",
        "inertiajs/inertia-laravel": "^1.3",
        "laravel/framework": "^10.0",
        "laravel/horizon": "^5.40",
        "laravel/sanctum": "^3.2",
        "laravel/tinker": "^2.8",
        "laravel/ui": "^4.2",
        "laravolt/avatar": "^5.0",
        "livewire/livewire": "^3.0",
        "maatwebsite/excel": "^3.1",
        "predis/predis": "^3.2",
        "sentry/sentry-laravel": "^4.6",
        "simplesoftwareio/simple-qrcode": "~4",
        "spatie/laravel-activitylog": "^4.7",
        "spatie/laravel-medialibrary": "^10.0.0",
        "spatie/laravel-permission": "^5.11",
        "spatie/laravel-robots-middleware": "^1.3",
        "spatie/laravel-translatable": "^6.8",
        "tightenco/ziggy": "^2.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.9",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
